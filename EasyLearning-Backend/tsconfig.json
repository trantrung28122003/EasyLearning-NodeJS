{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist", // Chỉ định thư mục đầu ra cho mã JavaScript đã biên dịch
    "rootDir": "./src", // Chỉ định thư mục chứa các file TypeScript của bạn
    "baseUrl": ".",
    "paths": {
      "@enums/*": ["src/enums/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
